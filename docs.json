{
  "$schema": "https://mintlify.com/docs.json",
  "name": "blueAccademy",
  "theme": "maple",
  "logo": {
    "light": "/logo/namelogo-compact.png",
    "dark": "/logo/namelogo-compact-dark.png",
    "href": "https://docs.blueaccademy.com/"
  },
  "colors": {
    "primary": "#3B82F6",
    "light": "#EFF6FF",
    "dark": "#1E3A5F"
  },
  "favicon": "/favicon.png",
  "appearance": {
    "default": "system",
    "strict": false
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "introduction",
              "quickstart",
              "installation/rancher-desktop",
              "installation/developer-tooling",
              "running-locally"
            ]
          },
          {
            "group": "Application",
            "pages": [
              "product/status",
              "flashcards/overview",
              "flashcards/study-flow",
              "flashcards/decks",
              "flashcards/custom-cards",
              "flashcards/anki-import",
              "flashcards/settings"
            ]
          },
          {
            "group": "Architecture",
            "pages": [
              "architecture/overview"
            ]
          },
          {
            "group": "Contributor Setup",
            "pages": [
              "contributing/overview",
              "contributing/docs-site"
            ]
          },
          {
            "group": "Troubleshooting",
            "pages": [
              "troubleshooting/faq",
              "troubleshooting/common-errors"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "primary": {
      "type": "github",
      "href": "https://github.com/SimoneParvizi/blueaccademy"
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/introduction"
    }
  ],
  "description": "blueAccademy is an open source learning platform for Kubernetes, Docker, Pulumi, GitHub Actions, and adjacent infrastructure workflows. This documentation covers installation, local development, architecture, and the current supported application flows",
  "seo": {
    "metatags": {
      "description": "blueAccademy is an open source learning platform for Kubernetes, Docker, Pulumi, GitHub Actions, and adjacent infrastructure workflows. This documentation covers installation, local development, architecture, and the current supported application flows",
      "og:site_name": "BlueAccademy Docs",
      "robots": "\"index, follow\"",
      "canonical": "\"https://docs.blueaccademy.com\""
    }
  }
}
