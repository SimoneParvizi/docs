{
  "$schema": "https://mintlify.com/docs.json",
  "name": "BlueAccademy",
  "theme": "maple",
  "logo": {
    "light": "/logo/namelogo-compact.png",
    "dark": "/logo/namelogo-compact-dark.png",
    "href": "https://docks.blueaccademy.com/"
  },
  "colors": {
    "primary": "#3B82F6",
    "light": "#EFF6FF",
    "dark": "#1E3A5F"
  },
  "favicon": "/favicon.png",
  "appearance": {
    "default": "system",
    "strict": false
  },
  "navigation": {
