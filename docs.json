          },
          {
            "group": "Application",
            "pages": [
              "product/status",
              "flashcards/overview",
              "flashcards/study-flow",
              "flashcards/decks",
              "flashcards/custom-cards",
              "flashcards/anki-import",
              "flashcards/settings"
            ]
          },
          {
            "group": "Architecture",
            "pages": [
              "architecture/overview"
            ]
          },
          {
            "group": "Contributor Setup",
            "pages": [
              "contributing/overview",
              "contributing/docs-site"
            ]
          },
          {
            "group": "Troubleshooting",
            "pages": [
              "troubleshooting/faq",
              "troubleshooting/common-errors"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "primary": {
      "type": "github",
      "href": "https://github.com/SimoneParvizi/blueaccademy"
